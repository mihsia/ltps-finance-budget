# Copy this file to .env and fill in values from your Firebase project settings
# (Firebase Console > Project settings > General > Your apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to develop against the local Firebase Emulator Suite
# (`firebase emulators:start`) instead of a real project — no values above
# are needed in that case.
VITE_USE_FIREBASE_EMULATOR=false
