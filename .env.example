# Copy this file to .env and fill in values from your Firebase project settings
# (Firebase Console > Project settings > General > Your apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 校級獨立帳號管理中心（方案 B：獨立 Firebase 專案 ltps-account-hub）
VITE_ACCOUNT_HUB_API_KEY=
VITE_ACCOUNT_HUB_AUTH_DOMAIN=ltps-account-hub.firebaseapp.com
VITE_ACCOUNT_HUB_PROJECT_ID=ltps-account-hub
VITE_ACCOUNT_HUB_APP_ID=
VITE_ACCOUNT_HUB_URL=https://ltps-account-hub.web.app

# Set to "true" to develop against the local Firebase Emulator Suite
# (`firebase emulators:start`) instead of a real project — no values above
# are needed in that case.
VITE_USE_FIREBASE_EMULATOR=false
