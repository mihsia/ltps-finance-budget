rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function userProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // A missing profile, or one whose status isn't the literal 'active',
    // fails closed — mirrors evaluateProfileAccess in src/lib/accessPolicy.js.
    function isActiveUser() { return isSignedIn() && userProfile().status == 'active'; }
    function isActiveAdmin() { return isActiveUser() && userProfile().role == 'admin'; }
    function canEditModule(moduleKey) {
      return isActiveAdmin()
        || (isActiveUser() && userProfile().role == 'editor' && moduleKey in userProfile().modules);
    }
    // Strict equality against the literal `false`, not a defaulting get() —
    // a missing/non-boolean `locked` field must read as locked, matching the
    // client's own "hides editing unless locked is exactly false" rule.
    function yearWritable(year) {
      return get(/databases/$(database)/documents/years/$(year)).data.locked == false;
    }
    function recordTypeUnchanged() {
      // `resource` is null on create (no prior document), so there is
      // nothing to preserve yet — nothing else here may dereference
      // resource.data before this check.
      return resource == null
        || !('recordType' in resource.data)
        || !('recordType' in request.resource.data)
        || request.resource.data.recordType == resource.data.recordType;
    }

    // Staff profiles: any signed-in user may always read their own doc (the
    // login flow's access check depends on it), and an admin or an editor
    // carrying the 'settings' module (帳號管理) may read any profile for the
    // account-management page — mirrors Settings.jsx's own canEditModule
    // gate, so the UI's "無權限" screen isn't just cosmetic. Writable only by
    // an active admin — accounts are actually created/edited/disabled via
    // Cloud Functions using the Admin SDK (createAccount/updateAccount/
    // setAccountStatus), which re-check this same rule server-side rather
    // than relying on it.
    match /users/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isActiveAdmin() || canEditModule('settings'));
      allow write: if isActiveAdmin();
    }

    match /years/{year} {
      // Budget data is presented to the county council and is meant to be
      // publicly readable for transparency; only admins manage year metadata.
      allow read: if true;
      allow write: if isActiveAdmin();

      match /modules/{moduleKey} {
        allow read: if true;
        allow write: if canEditModule(moduleKey) && yearWritable(year);

        // Multi-row modules (budget/language/awards/club/land/inquiry) store
        // rows here instead of as an array field on the module doc itself.
        match /records/{recordId} {
          allow read: if true;
          allow create, update: if canEditModule(moduleKey) && yearWritable(year) && recordTypeUnchanged();
          // Soft-delete via deletedAt/deletedBy on update above is the norm
          // everywhere in this app. This is the one deliberate exception: it
          // lets an admin truly remove a whole mistaken year's data (see
          // src/pages/Archive.jsx's "刪除年度" flow, the only caller) while
          // that year is still unlocked. Once a year is locked (archived),
          // yearWritable() is false and even an admin can no longer delete
          // anything here — archived data stays permanently immutable,
          // matching every other rule in this file.
          allow delete: if isActiveAdmin() && yearWritable(year);
        }
      }

      // Immutable audit trail for every module/record write. actorUid must
      // match the caller so nobody can forge another user's audit entry.
      match /auditLogs/{logId} {
        allow read: if true;
        allow create: if isActiveUser() && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Storage metadata for the budget-book PDF (see functions/index.js's
      // uploadBudgetBookPdf). That Cloud Function uses the Admin SDK, so this
      // rule only ever governs client reads.
      match /files/{fileId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /exports/{exportId} {
        allow read: if isActiveUser();
        allow create: if isActiveUser();
        allow update, delete: if false;
      }
    }
  }
}
